# Avalon node configuration example.
#
# Copy to .env (gitignored) or export the variables in your shell before
# ./scripts/start.sh. Only the variables you need to change must be set;
# everything else keeps its built-in default. Values marked "new in 2.0.x"
# did not exist on the old `new_net` line and change client behaviour when
# left at their defaults (see doc/migration-runbook-no-econs.en.md, S3).

# --- Ports & bind -----------------------------------------------------------
HTTP_PORT=3001
# HTTP_HOST default is 127.0.0.1 (local only). Set 0.0.0.0 to expose the API.
HTTP_HOST=0.0.0.0
#P2P_PORT=6001
#P2P_HOST=::

# --- MongoDB / storage ------------------------------------------------------
#DB_NAME=avalon
#DB_URL=mongodb://localhost:27017
#BLOCKS_DIR=/path/to/blocks

# --- Peering ----------------------------------------------------------------
PEERS=                       # comma-separated ws://host:port list
MAX_PEERS=20
#NO_DISCOVERY=1
#OFFLINE=1
#DISCOVERY_EXCLUDE=dtube

# --- Node identity (leader / miner) -----------------------------------------
NODE_OWNER=
NODE_OWNER_PUB=
NODE_OWNER_PRIV=

# --- HTTP security (new in 2.0.x) -------------------------------------------
# CORS_ORIGIN: default false = no CORS headers; set to your client origin or '*'
CORS_ORIGIN='*'
# TRUST_PROXY: only set when behind a reverse proxy (1 = first hop trusted)
#TRUST_PROXY=1
# Tokens protecting privileged endpoints. Leave unset only on a private/dev node:
# with no token configured, /mineBlock, /recover, /debug and /logs are reachable.
#ADMIN_TOKEN=
#LOG_ADMIN_TOKEN=

# --- Abuse limits (new in 2.0.x) --------------------------------------------
#CONTENT_MAX_COMMENTS=2000
#CONTENT_MAX_RESULTS=10000
#IMG_MAX_BYTES=10485760       # 10 MB max image download
#IMG_MAX_PIXELS=20000000      # 20 MPixels max image input
#MEMPOOL_SIZE=2000

# --- In-node log viewer (new in 2.0.x) --------------------------------------
#LOG_FULL=0
#LOG_PAGE=1

# --- Modules ----------------------------------------------------------------
#CONTENTS=1
#RANKINGS=1
#LEADER_STATS=1
#TX_HISTORY=1
#TX_HISTORY_ACCOUNTS=
#PLAYLIST_JSON=1

# --- Rebuild (leave commented out after a rebuild) --------------------------
#REBUILD_STATE=1
#REBUILD_WRITE_INTERVAL=10000
#REBUILD_NO_VALIDATE=1

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
#WARMUP_ACCOUNTS=100000
#WARMUP_CONTENTS=0
